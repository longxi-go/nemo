package consumer

import (
	"time"

	_ "github.com/longxi-go/nemo/pkg/binding"
)

type Duration = time.Duration

// +nemo:config:prefix=app
type Config struct {
	Value struct {
		Port    int      `default:"8080"`
		Keep    string   `property:"-"`
		Timeout Duration `default:"2s"`
		Nested  Server
	} `property:"http"`
	Pointer *struct {
		Enabled bool `default:"true"`
	}
	Last uint8
}

type Server struct {
	Name string `default:"server"`
}

// +nemo:config:prefix=required
type Required struct {
	Nested struct {
		Name string `required:"true"`
	}
}
