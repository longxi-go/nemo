package consumer

import (
	"errors"
	"strings"

	gosr "github.com/longxi-go/gosr/pkg/environment"
	"github.com/longxi-go/nemo/pkg/maptypes"
)

// DSLDecoder is an application codec; the Nemo core has no knowledge of its syntax.
type DSLDecoder struct{}

func (DSLDecoder) Decode(data []byte) (map[string]gosr.Value, error) {
	values := make(maptypes.ValueMap)
	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
		key, value, found := strings.Cut(line, " => ")
		if !found {
			return nil, errors.New("invalid DSL declaration")
		}
		if key == "app.servers" {
			items := []gosr.Value{}
			for _, port := range strings.Split(value, ";") {
				items = append(items, gosr.Object(maptypes.ValueMap{
					"port": gosr.String(port),
				}))
			}
			values[key] = gosr.List(items...)
		} else {
			values[key] = gosr.String(value)
		}
	}
	return values, nil
}
