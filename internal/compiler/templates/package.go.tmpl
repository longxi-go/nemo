// BindProperties replaces the target only after all fields bind successfully.
func ({{$names.Target}} *{{.Name}}) BindProperties({{$names.Resolver}} {{$names.Environment}}.PropertyResolver, {{$names.Prefix}} string) error {
 if {{$names.Target}} == nil || {{$names.Resolver}} == nil {
 return &{{$names.Environment}}.Error{
 Code: {{$names.Environment}}.InvalidState,
 }
 }
 if {{$names.Prefix}} != "" {
 if {{$names.Err}} := {{$names.Environment}}.ValidateKey({{$names.Prefix}}); {{$names.Err}} != nil {
 return {{$names.Err}}
 }
 }
 {{$names.Resolver}} = {{$names.Binding}}.Pin({{$names.Resolver}})
 {{$names.Next}}, {{$names.Err}} := {{.Helper}}({{$names.Resolver}}, {{$names.Prefix}}, *{{$names.Target}}, 0)
 if {{$names.Err}} != nil {
 return {{$names.Err}}
 }
 *{{$names.Target}} = {{$names.Next}}
 return nil
}
